VIBE_API_BASE_URL=https://triloapp-plan.onrender.com

# Firebase Phone Auth — TriloPlan Firebase project → Project settings → General → Your apps → Web app.
# Leave these empty to keep the old backend OTP login. Fill all four to switch to Firebase SMS.
VIBE_FIREBASE_API_KEY=
VIBE_FIREBASE_AUTH_DOMAIN=
VIBE_FIREBASE_PROJECT_ID=
VIBE_FIREBASE_APP_ID=

# Optional: link to an Android APK (e.g. built with pwabuilder.com from this site). When set, a
# "Download APK" button appears on /download and in Profile.
VIBE_ANDROID_APK_URL=
